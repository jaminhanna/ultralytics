newgraph

  y_translate
    -5.5

  xaxis
    min
      0.4
    max
      5.6
    size
      1

    no_auto_hash_marks
    no_auto_hash_labels

    hash_labels
      hjl
      vjc
      rotate
        -45

    hash_at
      1
    hash_label at
      1
      : YOLO11n
    hash_at
      2
    hash_label at
      2
      : YOLO11s
    hash_at
      3
    hash_label at
      3
      : YOLO11m
    hash_at
      4
    hash_label at
      4
      : YOLO11l
    hash_at
      5
    hash_label at
      5
      : YOLO11x
  yaxis
    min
      0
    size
      1.5
    label : Time (s)

  title
    y
      170
    font
      Times-Bold
    fontsize
      10
    : (Approximate) time per epoch

  newcurve
    marktype
      xbar
    marksize
      0.8 5
    cfill
      1 1 0
    pts
      shell : for i in nano small med large xlarge; \
              do \
                awk '{ \
                  if (NR > 1) { \
                    gsub(/,/, " "); \
                    sum = sum + $2 - last; \
                    last = $2 \
                  } \
                } \
                \
                END { \
                  if ("'$i'" == "nano") { \
                    i = 1 \
                  } else if ("'$i'" == "small") { \
                    i = 2 \
                  } else if ("'$i'" == "med") { \
                    i = 3 \
                  } else if ("'$i'" == "large") { \
                    i = 4 \
                  } else if ("'$i'" == "xlarge") { \
                    i = 5 \
                  } \
                  printf("%d %lf\n", i, sum / (NR - 1)) \
                }' $i/results.csv; \
              done

